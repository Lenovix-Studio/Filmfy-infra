{
  "version": "2.0.0",
  "tasks": [
    // ==========================================
    // 1. DEVELOPMENT TASKS (Split Terminal Aktif)
    // ==========================================
    {
      "label": "Dev Backend",
      "type": "shell",
      "command": "bun run start:dev",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "presentation": {
        "group": "fimlfy-dev",
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    // {
    //   "label": "Dev Python Uvicorn",
    //   "type": "shell",
    //   "command": ".\\venv\\Scripts\\uvicorn main:app --port 8000 --reload",
    //   "options": {
    //     "cwd": "${workspaceFolder}/py-filmfy"
    //   },
    //   "presentation": {
    //     "group": "fimlfy-dev",
    //     "reveal": "always",
    //     "panel": "dedicated"
    //   }
    // },
    {
      "label": "Dev Frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "presentation": {
        "group": "fimlfy-dev",
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "🚀 1. Mode: Development",
      "dependsOn": ["Dev Backend", "Dev Python Uvicorn", "Dev Frontend"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    // ==========================================
    // 2. BUILD TASKS (Berurutan & Auto-Close)
    // ==========================================
    {
      "label": "Build Backend",
      "type": "shell",
      "command": "bun run build",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "presentation": {
        "group": "fimlfy-build",
        "reveal": "always",
        "close": true
      }
    },
    {
      "label": "Build Frontend",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "presentation": {
        "group": "fimlfy-build",
        "reveal": "always",
        "close": true
      }
    },
    {
      "label": "📦 2. Mode: Build Project",
      "dependsOn": ["Build Backend", "Build Frontend"],
      "dependsOrder": "sequence",
      "group": "build"
    },
    // ==========================================
    // 3. PRODUCTION TASKS (Split Terminal Aktif)
    // ==========================================
    {
      "label": "Prod Backend",
      "type": "shell",
      "command": "bun run start:prod",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "presentation": {
        "group": "fimlfy-prod",
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    // {
    //   "label": "Prod Python Uvicorn",
    //   "type": "shell",
    //   "command": ".\\venv\\Scripts\\uvicorn main:app --port 8000",
    //   "options": {
    //     "cwd": "${workspaceFolder}/py-filmfy"
    //   },
    //   "presentation": {
    //     "group": "fimlfy-prod",
    //     "reveal": "always",
    //     "panel": "dedicated"
    //   }
    // },
    {
      "label": "Prod Frontend",
      "type": "shell",
      "command": "npm run start",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "presentation": {
        "group": "fimlfy-prod",
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "🔥 3. Mode: Production",
      "dependsOn": ["Prod Backend", "Prod Python Uvicorn", "Prod Frontend"],
      "group": "build"
    }
  ]
}
